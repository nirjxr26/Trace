# ==============================================================================
# Trace — Environment Configuration Template
# Copy to .env and adjust values for your environment.
# ==============================================================================

# Database Connection URL
# PostgreSQL (default):
TRACE_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trace
# SQLite (air-gapped / lightweight local mode):
# TRACE_DATABASE_URL=sqlite:///trace.db

# Base storage directory for cases, evidence & disk images
# Defaults to ~/.trace/storage if omitted
# TRACE_STORAGE_ROOT=~/.trace/storage

# Secret key used for cryptographic signatures / tokens
TRACE_SECRET_KEY=trace-local-dev-key-change-in-production

# Debug mode (0 = production clean error cards, 1 = verbose stack traces)
TRACE_DEBUG=0

# Update channel (stable|beta) and release manifest endpoint.
# The manifest is fetched over HTTPS and signature-verified against
# ~/.trace/trust/releases/ before anything is trusted. Unset disables checks.
# TRACE_UPDATE_CHANNEL=stable
# TRACE_UPDATE_MANIFEST=https://github.com/nirjxr26/Trace/releases/latest/download/stable.json

# SQL statement echo (0 = off). WARNING: SQL logs carry case content
# (titles, notes, examiner names). Keep 0 in production.
# TRACE_SQL_ECHO=0
